# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://hoacxszwuyymgpbkdywd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_8AWQsr0DKYEaV_DvHsYOBw_40lsdaML

# ─── Cloudinary ─────────────────────────────────────────────────────────────
# Get these from: https://cloudinary.com → Dashboard

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ─── WhatsApp ────────────────────────────────────────────────────────────────
# International format WITHOUT +, dashes or spaces. Example Argentina:
# 5491155556666  (54 = country code, 9 = mobile prefix, then number)

NEXT_PUBLIC_WHATSAPP_NUMBER=5493518045443

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Get these from: https://www.mercadopago.com.ar/developers/panel/credentials
# Use TEST-... tokens for sandbox, APP_USR-... for production

MERCADOPAGO_ACCESS_TOKEN=TEST-your_access_token_here
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Admin ───────────────────────────────────────────────────────────────────
# Clave para acceder a /admin?key=TU_CLAVE — elegí algo largo y aleatorio

ADMIN_SECRET=cambia_esto_por_una_clave_secreta

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Production domain (used to build back_urls and notification_url for MP)
# Leave empty in local dev — it auto-detects from the request host.

NEXT_PUBLIC_BASE_URL=https://tu-dominio.com
